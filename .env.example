# ==============================================================================
# CareOn - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development, or configure these variables
# in your cloud dashboard (Render for Backend, Vercel for Frontend, Neon for Database).
# NEVER commit actual secrets, keys, or passwords to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Configuration
# ------------------------------------------------------------------------------
# Options: development | production
ENVIRONMENT=development

# Port on which the FastAPI backend will run (Render provides this dynamically)
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# Local Development SQLite default:
DATABASE_URL=sqlite:///./careon.db

# Production Neon PostgreSQL Example (Uncomment and replace with Neon connection details):
# DATABASE_URL=postgresql://neondb_owner:YOUR_DB_PASSWORD@ep-example-pooler.c-2.neon.tech/neondb?sslmode=require

# Optional connection pool settings for PostgreSQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens and hashing sessions.
# In development, a fallback key is provided.
# In production (ENVIRONMENT=production), this variable is MANDATORY.
# Generate a secure 64-character hex key using:
#   openssl rand -hex 32
# or:
#   python -c "import secrets; print(secrets.token_hex(32))"
CAREON_SECRET_KEY=replace-with-a-secure-randomly-generated-64-character-hex-secret

# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend web origins.
# In development, localhost:3000 and localhost:5173 are permitted automatically.
# In production, specify your exact Vercel frontend URL:
CORS_ORIGINS=https://careon.vercel.app,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Demo Data & Production Admin Initialization
# ------------------------------------------------------------------------------
# In development, set to 'true' to pre-seed demo accounts (admin123/user123), resources, and incidents.
# In production, set to 'false' to disable fictional demo data.
SEED_DEMO_DATA=true

# When SEED_DEMO_DATA=false in production, use these variables to initialize your
# secure production command centre administrator account on first startup:
ADMIN_EMAIL=admin@yourdomain.org
ADMIN_PASSWORD=replace-with-a-strong-production-admin-password
ADMIN_NAME=Command Centre Administrator
ADMIN_PHONE=+91 821 244 5566

# ------------------------------------------------------------------------------
# 6. Frontend Configuration (Vercel / Vite)
# ------------------------------------------------------------------------------
# Set this in your Vercel project environment variables (Build & Development settings).
# Point to your Render backend API base URL:
VITE_API_URL=https://careon-backend.onrender.com/api
